        "2": [
          {"kind": "command", "argv": ["python", "-m", "pytest", "tests/test_server_chat_v2_max_mode.py", "-q", "-k", "transcribe_requires_audio_and_surfaces_errors"], "severity": "high"}
        ],
        "3": [
          {"kind": "live_probe", "probe": "voice_audio_roundtrip", "severity": "high"}
