          {"kind": "path_exists_any", "paths": ["thomas/server/routes/local_projects_aiohttp.py", "thomas/server/routes/search.py"], "severity": "high"},
          {"kind": "path_contains", "path": "thomas/server/routes/local_projects_aiohttp.py", "needles": ["/api/local/projects", "api_local_projects_list"], "severity": "high"}
