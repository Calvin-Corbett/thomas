      "tiers": {
        "1": [
          {"kind": "path_exists_any", "paths": ["thomas/server/routes/canvas_studio_routes.py", "thomas/server/chat_delegation_canvas.py"], "severity": "critical"},
          {"kind": "path_contains", "path": "thomas/server/deliverable_verify.py", "needles": ["VerifyResult", "verify_web_deliverable"], "severity": "critical"}
