        "2": [
          {"kind": "command", "argv": ["python", "-m", "pytest", "tests/test_canvas_studio_routes.py", "tests/test_chat_delegation_canvas.py", "-q"], "severity": "high"}
        ],
        "3": [
          {"kind": "live_probe", "probe": "canvas_artifact_matrix", "severity": "critical"}
        ],
        "4": [
          {"kind": "live_probe", "probe": "canvas_revision_integrity", "severity": "critical"}
        ]
      }
    },
    {
      "id": "memory-personalization",
      "name": "Memory, personalization, and user-controlled correction/deletion",
      "weight": 0.08,
      "critical": true,
      "behaviors": [
        "Remember useful facts, preferences, and goals across chats",
        "Use remembered context appropriately",
        "Show and correct memory",
        "Delete or disable memory without contaminating temporary chats"
      ],
      "tiers": {
        "1": [
          {"kind": "path_exists_any", "paths": ["thomas/server/routes/memory_aiohttp.py", "thomas/memory/v2"], "severity": "critical"},
          {"kind": "path_contains", "path": "thomas/marketplace/specialists/reasoning.py", "needles": ["remember", "recall"], "severity": "critical"}
        ],
        "2": [
          {"kind": "command", "argv": ["python", "-m", "pytest", "tests/test_memory_system.py", "tests/test_memory_layers.py", "-q"], "severity": "high"},
          {"kind": "api_json", "path": "/api/memory", "required_keys": ["enabled", "stats", "v2_health"], "severity": "high"}
        ],
        "3": [
          {"kind": "live_probe", "probe": "memory_cross_session_recall", "severity": "critical"}
        ],
        "4": [
          {"kind": "live_probe", "probe": "memory_correction_deletion_isolation", "severity": "critical"}
        ]
      }
    },
