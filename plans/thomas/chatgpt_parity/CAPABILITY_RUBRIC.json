{
  "schema_version": "thomas-chatgpt-parity-v1",
  "target": "Current user-facing ChatGPT capability parity",
  "as_of": "2026-07-13",
  "source_urls": [
    "https://help.openai.com/en/articles/9260256-chatgpt-capabilities-overview",
    "https://help.openai.com/en/articles/6825453-chatgpt-release-notes",
    "https://help.openai.com/en/articles/8554407-gpts-faq",
    "https://openai.com/index/introducing-deep-research/",
    "https://learn.chatgpt.com/docs/use-chatgpt",
    "https://learn.chatgpt.com/docs/customization/memories",
    "https://learn.chatgpt.com/docs/projects",
    "https://learn.chatgpt.com/docs/automations",
    "https://developers.openai.com/api/docs/guides/latest-model",
    "https://developers.openai.com/api/docs/models/gpt-5.6-sol",
    "https://developers.openai.com/api/docs/models/gpt-5.6-terra",
    "https://developers.openai.com/api/docs/models/gpt-5.6-luna"
  ],
  "scoring": {
    "0": "Absent, contradicted, or no executable evidence",
    "1": "Declared or statically wired; no executed contract proof",
    "2": "Deterministic executable contract proof",
    "3": "Live normal-case proof through the user-facing runtime",
    "4": "Live adversarial, recovery, persistence, or steerability proof"
  },
  "parity_rule": "Every family must score 4/4. Missing or unimplemented evidence fails closed; weighted averages never waive a family.",
  "families": [
    {
      "id": "core-conversation-instructions",
      "name": "Conversation, reasoning, writing, translation, and instruction fidelity",
      "weight": 0.11,
      "critical": true,
      "behaviors": [
        "Answer and explain",
        "Draft, rewrite, summarize, create, reason, and translate",
        "Follow multiple constraints",
        "Carry and revise context across turns"
      ],
      "tiers": {
        "1": [
          {"kind": "path_contains", "path": "thomas/server/routes/chat_v2.py", "needles": ["/api/v2/chat", "ConversationManager"], "severity": "critical"},
          {"kind": "path_contains", "path": "thomas/marketplace/specialists/reasoning.py", "needles": ["THOMAS_OPERATOR_SYSTEM_PROMPT", "conversation_context"], "severity": "critical"}
        ],
        "2": [
          {"kind": "command", "argv": ["python", "-m", "pytest", "tests/test_orchestrator_brain_coverage.py", "-q"], "severity": "critical"}
        ],
        "3": [
          {"kind": "live_probe", "probe": "conversation_multi_turn", "severity": "critical"}
        ],
        "4": [
          {"kind": "live_probe", "probe": "conversation_adversarial_followup", "severity": "critical"},
          {"kind": "live_probe", "probe": "conversation_benign_token_refusal", "severity": "critical"}
        ]
      }
    },
    {
      "id": "web-search-deep-research",
      "name": "Current web search, citations, and deep multi-source research",
      "weight": 0.10,
      "critical": true,
      "behaviors": [
        "Find current information on the web",
        "Cite sources beside supported claims",
        "Perform multi-step, multi-source research",
        "Produce a structured synthesis that can be refined"
      ],
      "tiers": {
        "1": [
          {"kind": "path_exists_any", "paths": ["thomas/tools/web_search.py", "thomas/tools/web_search_providers.py"], "severity": "critical"},
          {"kind": "path_contains", "path": "thomas/marketplace/specialists/research.py", "needles": ["web_search", "fact_checking", "summarization"], "severity": "high"}
        ],
        "2": [
          {"kind": "command", "argv": ["python", "-m", "pytest", "tests/test_cli_research_commands.py", "-q"], "severity": "high"}
        ],
        "3": [
          {"kind": "live_probe", "probe": "web_search_cited_answer", "severity": "critical"}
        ],
          "4": [
            {"kind": "live_probe", "probe": "web_source_conflict", "severity": "critical"}
          ]
      }
    },
    {
      "id": "multimodal-images",
      "name": "Image understanding, generation, and natural-language editing",
      "weight": 0.07,
      "critical": false,
      "behaviors": [
        "Analyze screenshots, diagrams, charts, and photos",
        "Extract and interpret visual content",
        "Generate images from text",
        "Edit an existing or generated image"
      ],
      "tiers": {
        "1": [
          {"kind": "path_contains", "path": "thomas/server/routes/chat_v2.py", "needles": ["image_data", "image_url"], "severity": "high"},
          {
            "kind": "path_contains",
            "path": "thomas/marketplace/vision/handler.py",
            "needles": ["input_image", "image_url", "extract_text_from_images"],
            "severity": "high"
          }
        ],
        "2": [
          {"kind": "command", "argv": ["python", "-m", "pytest", "tests/test_server_chat_v2_max_mode.py", "-q", "-k", "text_fallback_attaches_docs_and_images"], "severity": "high"}
        ],
        "3": [
          {"kind": "live_probe", "probe": "image_understanding_generation_edit", "severity": "high"}
        ],
        "4": [
          {"kind": "live_probe", "probe": "image_visual_injection_edit_fidelity", "severity": "high"}
        ]
      }
    },
    {
      "id": "files-documents",
      "name": "File uploads, document understanding, and downloadable document work",
      "weight": 0.07,
      "critical": false,
      "behaviors": [
        "Accept PDFs, presentations, text, and other documents",
        "Summarize and extract grounded information",
        "Answer questions from uploaded content",
        "Create and return usable document artifacts"
      ],
      "tiers": {
        "1": [
          {"kind": "path_contains", "path": "thomas/server/routes/chat_v2.py", "needles": ["Attached documents", "docs = payload.get"], "severity": "high"},
          {"kind": "tools_any", "patterns": ["pdf", "document", "file"], "minimum": 1, "severity": "high"}
        ],
        "2": [
          {"kind": "command", "argv": ["python", "-m", "pytest", "tests/test_server_chat_v2_max_mode.py", "-q", "-k", "text_fallback_attaches_docs_and_images"], "severity": "high"}
        ],
        "3": [
          {"kind": "live_probe", "probe": "document_upload_grounded_artifact", "severity": "high"}
        ],
        "4": [
          {"kind": "live_probe", "probe": "document_conflict_truncation_grounding", "severity": "high"}
        ]
      }
    },
    {
      "id": "data-code-charts",
      "name": "Secure code execution, data analysis, spreadsheets, and charts",
      "weight": 0.08,
      "critical": true,
      "behaviors": [
        "Run code in an isolated environment",
        "Analyze and clean structured data",
        "Calculate projections and summarize trends",
        "Create accurate static or interactive visualizations"
      ],
      "tiers": {
        "1": [
          {"kind": "tools_any", "patterns": ["data_", "code.", "spreadsheet", "chart"], "minimum": 3, "severity": "critical"},
          {"kind": "path_exists_any", "paths": ["thomas/tools/engineering.py", "thomas/server/deliverable_verify.py"], "severity": "high"}
        ],
        "2": [
          {"kind": "api_json", "path": "/api/tools", "required_keys": ["tools", "count"], "severity": "high"}
        ],
        "3": [
          {"kind": "live_probe", "probe": "data_code_chart_roundtrip", "severity": "critical"}
        ],
        "4": [
          {"kind": "live_probe", "probe": "data_dirty_formula_sandbox", "severity": "critical"}
        ]
      }
    },
    {
      "id": "voice-dictation",
      "name": "Voice conversation, dictation, transcription, and spoken responses",
      "weight": 0.05,
      "critical": false,
      "behaviors": [
        "Transcribe natural speech and dictation",
        "Support conversational spoken input and output",
        "Handle interruptions and turn-taking",
