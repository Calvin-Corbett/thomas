        ],
        "4": [
          {"kind": "live_probe", "probe": "project_isolation_stale_share", "severity": "high"}
        ]
      }
    },
    {
      "id": "scheduled-monitoring",
      "name": "One-time, recurring, triggered, and monitoring tasks",
      "weight": 0.07,
      "critical": true,
      "behaviors": [
