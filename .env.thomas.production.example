THOMAS_ENV=production
THOMAS_ALLOW_REMOTE_PRODUCTION=1
THOMAS_SERVER_ACCESS_MODE=remote
THOMAS_SERVER_API_TOKEN=REPLACE_WITH_STRONG_RANDOM_TOKEN
THOMAS_SERVER_RATE_LIMIT_ENABLED=true
THOMAS_SERVER_RATE_LIMIT_MAX_REQUESTS=120
THOMAS_SERVER_RATE_LIMIT_WINDOW_SECONDS=60
THOMAS_ALLOW_UNAUTHENTICATED_VERSION=true
THOMAS_MUTATING_CSRF_TOKEN=REPLACE_WITH_STRONG_RANDOM_TOKEN

# Logging
THOMAS_LOG_LEVEL=WARNING
THOMAS_LOG_FORMAT=json
THOMAS_LOG_FILE=%USERPROFILE%\\.thomas\\server.log
THOMAS_LOG_MAX_BYTES=10485760
THOMAS_LOG_BACKUP_COUNT=7

# Server process logs when launched from tray agent
THOMAS_SERVER_LOG_MAX_BYTES=8388608
THOMAS_SERVER_LOG_BACKUP_COUNT=5

# Tray-agent log tuning
THOMAS_TRAY_LOG_MAX_BYTES=8388608
THOMAS_TRAY_LOG_BACKUP_COUNT=5
