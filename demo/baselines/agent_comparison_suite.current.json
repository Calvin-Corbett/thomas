        ]
      },
      "gateway_patterns": {
        "chat_completions": "/v1/chat/completions",
        "responses": "/v1/responses"
      },
      "strict_checks": [
        {
          "id": "workflow_profiles_cli",
          "command": [
            "{python}",
            "-m",
            "thomas",
            "browser",
            "workflows",
            "list",
            "--json",
            "--limit",
            "25"
          ],
          "assertions": [
            {
              "path": "count",
              "op": "eq",
              "value": 25
            },
            {
              "path": "profiles.0.profile_id",
              "op": "truthy",
              "value": true
            }
          ]
        },
        {
          "id": "workflow_corpus_validate",
          "command": [
            "{python}",
            "-m",
            "thomas",
            "browser",
            "workflow-cases",
            "validate",
            "--json",
            "--limit",
            "300"
          ],
          "assertions": [
            {
              "path": "total",
              "op": "eq",
              "value": 300
            },
            {
              "path": "valid",
              "op": "eq",
              "value": 300
            },
            {
              "path": "invalid",
              "op": "eq",
              "value": 0
            }
          ]
        },
        {
          "id": "extension_catalog_strict",
          "command": [
            "{python}",
            "-m",
            "thomas",
            "plugins",
            "extension-catalog",
            "--json",
            "--strict"
          ],
          "assertions": [
            {
              "path": "total",
              "op": "gte",
              "value": 480
            },
            {
              "path": "valid",
              "op": "gte",
              "value": 480
            },
            {
              "path": "invalid",
              "op": "eq",
              "value": 0
            }
          ]
        },
        {
          "id": "production_asset_tests",
          "command": [
            "{python}",
            "-m",
            "pytest",
            "-q",
            "tests/test_browser_workflow_runtime.py",
            "tests/test_extension_catalog_runtime.py",
            "tests/test_cli_production_assets_integration.py"
          ]
        }
      ],
      "performance_probes": [
        {
          "id": "perf_workflow_corpus_validate",
          "repeat": 3,
          "command": [
            "{python}",
            "-m",
            "thomas",
            "browser",
            "workflow-cases",
            "validate",
            "--json",
            "--limit",
