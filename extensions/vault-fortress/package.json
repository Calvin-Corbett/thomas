{
  "name": "thomas-vault-fortress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:broker": "tsx src/broker/main.ts",
    "dev:ui": "tsx src/ui/server.ts",
    "broker": "node dist/broker/main.js",
    "ui": "node dist/ui/server.js",
    "cli": "node dist/cli/index.js",
    "test": "node --test dist/tests/*.test.js",
    "lint:quick": "node dist/tools/quickcheck.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "express": "^4.22.2",
    "libsodium-wrappers-sumo": "^0.7.15",
    "nanoid": "^5.1.11",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3"
  }
}
