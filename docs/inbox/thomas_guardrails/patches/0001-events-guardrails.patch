diff --git a/thomas/core/events.py b/thomas/core/events.py
index 0000000..0000000 100644
--- a/thomas/core/events.py
+++ b/thomas/core/events.py
@@
+# --- GUARDRAILS BEGIN ---
+TOOL_APPROVAL_REQUIRED = "TOOL_APPROVAL_REQUIRED"
+TOOL_APPROVAL_RESOLVED = "TOOL_APPROVAL_RESOLVED"
+
+# If AgentEvent helper exists, add these helpers to keep event creation consistent.
+try:
+    AgentEvent  # type: ignore[name-defined]
+except Exception:
+    AgentEvent = None  # type: ignore
+
+if AgentEvent is not None:
+    def _ae(**kwargs):
+        return AgentEvent(**kwargs)  # type: ignore
+
+    def tool_approval_required(run_id: str, tool_call_id: str, session_id: str, tool_name: str, args: dict, reason: str, iteration: int):
+        return _ae(type=TOOL_APPROVAL_REQUIRED, data={
+            "run_id": run_id,
+            "tool_call_id": tool_call_id,
+            "session_id": session_id,
+            "tool_name": tool_name,
+            "args": args,
+            "reason": reason,
+            "iteration": iteration,
+        })
+
+    def tool_approval_resolved(run_id: str, tool_call_id: str, tool_name: str, approved: bool):
+        return _ae(type=TOOL_APPROVAL_RESOLVED, data={
+            "run_id": run_id,
+            "tool_call_id": tool_call_id,
+            "tool_name": tool_name,
+            "approved": approved,
+        })
+# --- GUARDRAILS END ---
