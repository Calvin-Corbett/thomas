+export async function apiGet(path){
+  const r = await fetch(path, {method:"GET", headers: {"Accept":"application/json"}});
+  if (!r.ok) throw new Error(`GET ${path} -> ${r.status}`);
+  return await r.json();
+}
+
+export async function apiStreamNDJSON(path, onObj){
+  const r = await fetch(path, {method:"GET", headers: {"Accept":"application/x-ndjson"}});
+  if (!r.ok) throw new Error(`STREAM ${path} -> ${r.status}`);
+  const reader = r.body.getReader();
+  const decoder = new TextDecoder("utf-8");
+  let buf = "";
+  while (true){
+    const {value, done} = await reader.read();
+    if (done) break;
+    buf += decoder.decode(value, {stream:true});
+    let idx;
+    while ((idx = buf.indexOf("\n")) >= 0){
+      const line = buf.slice(0, idx).trim();
+      buf = buf.slice(idx+1);
+      if (!line) continue;
+      try { onObj(JSON.parse(line)); }
+      catch (e){ console.warn("Bad NDJSON line", e, line); }
+    }
+  }
+}
