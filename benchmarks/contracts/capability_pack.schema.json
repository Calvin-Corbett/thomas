{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thomas.local/benchmarks/contracts/capability_pack.schema.json",
  "title": "Thomas Capability Benchmark Pack",
  "type": "object",
  "required": ["id", "name", "version", "type", "family", "tasks"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "type": { "const": "capability" },
    "family": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "protocol": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "competitor_requirements": {
      "type": "object",
      "properties": {
        "required_capability_class": {
          "type": "string",
          "enum": ["text_only", "tool_using_agent", "tool_using_multi_agent"]
        }
      },
      "additionalProperties": false
    },
    "report_metrics": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "weights": {
      "type": "object",
      "properties": {
        "success_rate": { "type": "number", "minimum": 0 },
        "speed": { "type": "number", "minimum": 0 },
        "follow_up": { "type": "number", "minimum": 0 },
        "quality": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "quality_scale": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "prompt", "success"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "success_criteria": { "type": "string" },
          "time_budget_seconds": { "type": "integer", "minimum": 1 },
          "success": {
            "type": "object",
            "properties": {
              "response_contains": { "type": "array", "items": { "type": "string" } },
              "response_regex": { "type": "array", "items": { "type": "string" } },
              "response_python_compiles": { "type": "boolean" },
              "response_python_prefix": { "type": "string" },
              "response_entry_point": { "type": "string" },
              "required_files": { "type": "array", "items": { "type": "string" } },
              "required_file_contains": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "required_file_regex": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "check_command": { "type": "string" },
              "check_timeout_seconds": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
