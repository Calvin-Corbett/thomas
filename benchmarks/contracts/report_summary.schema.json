{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thomas.local/benchmarks/contracts/report_summary.schema.json",
  "title": "Thomas Benchmark Summary",
  "type": "object",
  "required": ["run_id", "summary"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "task_pack_id": { "type": "string" },
    "task_pack_version": { "type": "integer" },
    "competitors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": {
      "type": "object",
      "properties": {
        "competitors": { "type": "object" },
        "ranking": { "type": "array" },
        "credibility_ranking": { "type": "array" },
        "task_winners": { "type": "array" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
