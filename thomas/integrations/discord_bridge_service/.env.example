DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_server_id_for_fast_slash_command_sync
DISCORD_ALLOWED_GUILD_IDS=your_server_id
DISCORD_AUTO_CHANNEL_IDS=
DISCORD_OWNER_USER_IDS=your_discord_user_id
DISCORD_OWNER_ONLY_MODE=false
# When owner-only mode is on, the owner can still grant limited chat/music access in Discord chat.
DISCORD_REQUIRE_MENTION=true
DISCORD_VOICE_AUTO_JOIN=false
DISCORD_DEFAULT_VOICE_CHANNEL_NAME=General
DISCORD_VOICE_REQUIRE_WAKE_WORD=true
DISCORD_VOICE_WAKE_WORDS=thomas,hey thomas,yo thomas,okay thomas,ok thomas
DISCORD_VOICE_SILENCE_MS=700
DISCORD_VOICE_MIN_SPEECH_MS=220
DISCORD_VOICE_MAX_SPEECH_MS=20000
DISCORD_VOICE_WAKE_CAPTURE_MS=6500
DISCORD_VOICE_NO_WAKE_COOLDOWN_MS=8000
DISCORD_VOICE_MAX_REPLY_CHARS=320
DISCORD_VOICE_MEDIA_VOLUME=100
DISCORD_VOICE_ANNOUNCE_ON_JOIN=true
DISCORD_VOICE_NAME=
DISCORD_VOICE_TTS_BACKEND=piper
DISCORD_VOICE_TTS_PYTHON=python
DISCORD_VOICE_TTS_MODEL=en_US-lessac-medium
DISCORD_VOICE_TTS_DATA_DIR=data/piper-voices
DISCORD_VOICE_TTS_USE_CUDA=false
DISCORD_VOICE_TTS_SENTENCE_PAUSE_MS=140
DISCORD_VOICE_TTS_LENGTH_SCALE=0.9
# Installed local voice profiles can be switched live with /voice profile:
# en_US-ryan-high, en_US-lessac-high, en_US-lessac-medium
DISCORD_VOICE_CLOUD_VOICE=alloy
DISCORD_VOICE_CLOUD_RESPONSE_FORMAT=wav
DISCORD_VOICE_OPENAI_API_KEY=
DISCORD_VOICE_OPENAI_BASE_URL=https://api.openai.com/v1
DISCORD_VOICE_STT_BACKEND=faster-whisper
DISCORD_VOICE_STT_PYTHON=python
DISCORD_VOICE_STT_MODEL=distil-large-v3
DISCORD_VOICE_STT_DEVICE=cpu
DISCORD_VOICE_STT_COMPUTE_TYPE=int8
DISCORD_VOICE_STT_BEAM_SIZE=1
DISCORD_VOICE_STT_VAD_FILTER=true
DISCORD_VOICE_STT_LANGUAGE=en
DISCORD_MEDIA_PYTHON=python
DISCORD_MEDIA_SEARCH_LIMIT=3

# RTX/NVIDIA local profile example:
# DISCORD_VOICE_TTS_MODEL=en_US-ryan-high
# DISCORD_VOICE_TTS_USE_CUDA=true
# DISCORD_VOICE_STT_DEVICE=cuda
# DISCORD_VOICE_STT_COMPUTE_TYPE=float16

# Cloud voice example:
# DISCORD_VOICE_TTS_BACKEND=openai
# DISCORD_VOICE_TTS_MODEL=gpt-4o-mini-tts
# DISCORD_VOICE_STT_BACKEND=openai
# DISCORD_VOICE_STT_MODEL=gpt-4o-mini-transcribe
# The bridge will also reuse THOMAS_MODELS_OPENAI_API_KEY automatically if Thomas already has it.

THOMAS_BASE_URL=http://127.0.0.1:8899
THOMAS_SERVER_API_TOKEN=
THOMAS_REQUEST_TIMEOUT_MS=180000

SESSION_PREFIX=thomas-discord
DISCORD_MAX_REPLY_CHARS=1900
