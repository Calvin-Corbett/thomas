+/* thomas/server/web/css/replay_debugger.css */
+:root {
+  --bg: #0b0f14;
+  --panel: #0f1621;
+  --panel2: #0c121b;
+  --text: #d6e1f0;
+  --muted: #93a7c3;
+  --accent: #73b7ff;
+  --border: rgba(255,255,255,0.08);
+  --shadow: 0 10px 30px rgba(0,0,0,0.35);
+}
+* { box-sizing: border-box; }
+html, body { height: 100%; margin: 0; font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial; background: var(--bg); color: var(--text); }
+.topbar { display:flex; align-items:center; justify-content:space-between; padding:12px 14px; border-bottom:1px solid var(--border); position:sticky; top:0; background: rgba(11,15,20,0.92); backdrop-filter: blur(10px); }
+.brand { display:flex; gap:10px; align-items:center; }
+.logo { width:34px; height:34px; border-radius:12px; display:flex; align-items:center; justify-content:center; background: linear-gradient(135deg, rgba(115,183,255,0.2), rgba(115,183,255,0.05)); border:1px solid var(--border); color:var(--accent); font-weight:700; }
+.title { font-size:14px; font-weight:700; }
+.subtitle { font-size:12px; color: var(--muted); margin-top:2px; }
+.actions { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
+.inline { display:flex; gap:8px; align-items:center; color: var(--muted); font-size:12px; }
+select, button, input { background: var(--panel); color: var(--text); border:1px solid var(--border); border-radius:10px; padding:8px 10px; outline:none; }
+button { cursor:pointer; }
+button:disabled { opacity:0.5; cursor:default; }
+button:hover:not(:disabled) { border-color: rgba(115,183,255,0.35); }
+.layout { display:grid; grid-template-columns: 420px 1fr; gap:12px; padding:12px; }
