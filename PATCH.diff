+.eventRow:hover { background: rgba(115,183,255,0.05); }
+.eventRow.active { outline:1px solid rgba(115,183,255,0.35); background: rgba(115,183,255,0.08); }
+.eventMeta { display:flex; flex-direction:column; gap:4px; }
+.eventType { font-weight:650; font-size:12px; }
+.eventSmall { font-size:12px; color: var(--muted); }
