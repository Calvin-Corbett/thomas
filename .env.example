# Thomas AI Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ─── Environment ───────────────────────────────────────────
# development | production (default: development)
THOMAS_ENV=development

# ─── API Keys (set the ones you use) ──────────────────────
# THOMAS_MODELS_OPENAI_API_KEY=sk-...
# THOMAS_MODELS_ANTHROPIC_API_KEY=sk-ant-...
# THOMAS_MODELS_XAI_API_KEY=xai-...
# THOMAS_MODELS_GEMINI_API_KEY=...
# THOMAS_MODELS_OPENROUTER_API_KEY=sk-or-...

# ─── Server ────────────────────────────────────────────────
# THOMAS_SERVER_ACCESS_MODE=local
# THOMAS_SERVER_API_TOKEN=       # required if access_mode=remote
# THOMAS_SERVER_PORT=8899

# ─── Config file (optional — defaults to ./thomas.toml) ───
# THOMAS_CONFIG=/path/to/thomas.toml

# ─── Logging ───────────────────────────────────────────────
# THOMAS_LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR
# THOMAS_LOG_FORMAT=text         # text | json
