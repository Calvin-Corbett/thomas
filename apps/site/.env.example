THOMAS_GITHUB_REPO=your-org/your-repo
THOMAS_RELEASE_CHANNEL=stable

# Optional GitHub token for higher API rate limits.
GITHUB_TOKEN=

# Postgres for download click tracking.
DATABASE_URL=

# Optional salt for anonymized IP hashing in event logs.
EVENT_HASH_SALT=

# Optional PostHog server-side event forwarding.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional site URL for canonical metadata.
SITE_URL=https://thomas.dev
