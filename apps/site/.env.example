THOMAS_GITHUB_REPO=your-org/your-repo
THOMAS_RELEASE_CHANNEL=stable

# Download source mode:
# - auto: prefer manual URLs if present, then fall back to GitHub releases
# - manual: only manual URLs
# - github: only GitHub releases
THOMAS_DOWNLOAD_MODE=auto

# Manual download URLs (optional but recommended for website-first launch).
THOMAS_DOWNLOAD_URL_WINDOWS=
THOMAS_DOWNLOAD_URL_MACOS=
THOMAS_DOWNLOAD_URL_LINUX=
THOMAS_DOWNLOAD_URL_WINDOWS_BETA=
THOMAS_DOWNLOAD_URL_MACOS_BETA=
THOMAS_DOWNLOAD_URL_LINUX_BETA=
THOMAS_MANUAL_RELEASE_TAG=website-launch

# Optional GitHub token for higher API rate limits.
GITHUB_TOKEN=

# Postgres for download click tracking.
DATABASE_URL=

# Optional salt for anonymized IP hashing in event logs.
EVENT_HASH_SALT=

# Optional PostHog server-side event forwarding.
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional site URL for canonical metadata.
SITE_URL=https://thomas.dev

# Cloudflare deploy (only needed for deploy commands)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
