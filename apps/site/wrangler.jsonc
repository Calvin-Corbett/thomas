{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thomas-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-02-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "thomas-site-preview",
      "workers_dev": true,
      "preview_urls": true
    }
  }
}
