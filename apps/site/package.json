{
  "name": "thomas-site",
  "version": "0.1.0",
  "private": true,
  "description": "Public download and updates website for Thomas.",
  "scripts": {
    "dev": "next dev",
    "build": "python ../../scripts/export_site_marketplace_snapshot.py && next build --webpack",
    "start": "next start",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "verify:visual": "python ../../scripts/forge/gates/site_visual_proof.py",
    "verify:visual:runtime": "node ../../scripts/verify_site_visual_runtime.mjs",
    "verify:visual:refresh": "python ../../scripts/refresh_site_visual_proof.py",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:preview": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@splinetool/viewer": "1.10.10",
    "gsap": "^3.15.0",
    "next": "^16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright": "^1.62.1",
    "typescript": "^5.8.2",
    "wrangler": "^4.125.0"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
