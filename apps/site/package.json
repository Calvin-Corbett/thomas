{
  "name": "thomas-site",
  "version": "0.1.0",
  "private": true,
  "description": "Public download and updates website for Thomas.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "verify:visual": "python ../../scripts/check_site_visual_proof.py",
    "verify:visual:runtime": "node ../../scripts/verify_site_visual_runtime.mjs",
    "verify:visual:refresh": "python ../../scripts/refresh_site_visual_proof.py",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:preview": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.7.0",
    "gsap": "^3.14.2",
    "next": "^16.1.6",
    "postgres": "^3.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "playwright": "^1.58.2",
    "typescript": "^5.8.2",
    "wrangler": "^4.67.0"
  }
}
